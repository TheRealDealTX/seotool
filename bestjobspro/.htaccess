# Best Jobs Pro - custom PHP site (Hostinger / LiteSpeed)
Options -Indexes
DirectoryIndex index.php
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Drop www. (index.php also upgrades plain-http requests; turn on Force HTTPS in hPanel too)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://bestjobspro.com%{REQUEST_URI} [R=301,L]

# Source folders are never served directly
RewriteRule ^(inc|content)(/|$) - [F,L]

# Everything that is not a real file goes through the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(md|sh|py|json|lock|log|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
