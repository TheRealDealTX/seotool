DirectoryIndex index.html index.php
Options -Indexes -MultiViews
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType image/avif .avif
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType text/javascript "access plus 30 days"
ExpiresByType image/webp "access plus 90 days"
ExpiresByType image/png "access plus 90 days"
ExpiresByType image/svg+xml "access plus 90 days"
ExpiresByType image/x-icon "access plus 90 days"
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.jmautida\.com$ [NC]
RewriteRule ^ https://jmautida.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^jmautida\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://jmautida.com%{REQUEST_URI} [R=301,L,NE]
# Never serve server-side helpers, private config or the WordPress-era backup.
RewriteRule ^api/(?:lib|mailer|config[^/]*)\.php$ - [F,L]
RewriteRule ^(?:backup|_private)(?:/|$) - [F,L]
# Legacy query-based tool URLs.
RewriteCond %{QUERY_STRING} (^|&)tool=meta(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/meta-tags-checker [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=time(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/time-calculator [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=html(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/html-playground [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=json(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/json-formatter [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=encode(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/url-encoder-decoder [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=words(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/word-counter [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=markdown(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/markdown-to-word [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=favicon(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/favicon-checker [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)tool=contrast(&|$) [NC]
RewriteRule ^tool(?:\.html)?/?$ /tools/contrast-checker [R=301,L,QSD]
RewriteRule ^tool(?:\.html)?/?$ /tools [R=301,L,QSD]
# Friendly aliases for the image converter.
RewriteRule ^tools/(?:webp-converter|convert-to-webp|image-compressor)/?$ /tools/image-converter [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.(?:html|php)(?:[?\s]) [NC]
RewriteRule ^index\.(?:html|php)$ / [R=301,L]
RewriteRule ^(?:portfolio|work)(?:\.html)?/?$ / [R=301,L,QSD]
RewriteRule ^resume(?:\.html)?/?$ /about [R=301,L,QSD]
RewriteCond %{THE_REQUEST} \s/+(tools|about|contact|privacy)\.html(?:[?\s]) [NC]
RewriteRule ^(tools|about|contact|privacy)\.html$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+pages/(image-converter|meta-tags-checker|time-calculator|html-playground|json-formatter|url-encoder-decoder|word-counter|markdown-to-word|favicon-checker|contrast-checker)\.html(?:[?\s]) [NC]
RewriteRule ^pages/(image-converter|meta-tags-checker|time-calculator|html-playground|json-formatter|url-encoder-decoder|word-counter|markdown-to-word|favicon-checker|contrast-checker)\.html$ /tools/$1 [R=301,L]
RewriteRule ^(tools/(?:image-converter|meta-tags-checker|time-calculator|html-playground|json-formatter|url-encoder-decoder|word-counter|markdown-to-word|favicon-checker|contrast-checker)|tools|about|contact|privacy)/+$ /$1 [R=301,L]
RewriteRule ^tools/(image-converter|meta-tags-checker|time-calculator|html-playground|json-formatter|url-encoder-decoder|word-counter|markdown-to-word|favicon-checker|contrast-checker)$ pages/$1.html [L]
RewriteRule ^(tools|about|contact|privacy)$ $1.html [L]
</IfModule>
