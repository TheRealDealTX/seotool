# Houston Public Adjusters - custom PHP site (replaces WordPress)
Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://houstonpublicadjusting.com/$1 [R=301,L]

# Retired WordPress URLs -> nearest equivalent
RewriteRule ^(post|page|category)-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(wp-sitemap.*\.xml)$ /sitemap.xml [R=301,L]
RewriteRule ^feed/?$ /blog/ [R=301,L]
RewriteRule ^comments/feed/?$ /blog/ [R=301,L]
RewriteRule ^category/general/feed/?$ /category/general/ [R=301,L]
RewriteRule ^([a-z0-9-]+)/feed/?$ /$1/ [R=301,L]
RewriteRule ^blog/page/[0-9]+/?$ /blog/ [R=301,L]
RewriteRule ^page/[0-9]+/?$ /blog/ [R=301,L]
RewriteRule ^20[0-9]{2}(/[0-9]{2}){0,2}/?$ /blog/ [R=301,L]
RewriteRule ^20[0-9]{2}(/[0-9]{2}){0,2}/page/[0-9]+/?$ /blog/ [R=301,L]
RewriteRule ^tag/.*$ /blog/ [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)s= [OR]
RewriteCond %{QUERY_STRING} (^|&)p=[0-9]+ [OR]
RewriteCond %{QUERY_STRING} (^|&)page_id=[0-9]+
RewriteRule ^$ /blog/? [R=301,L]
RewriteRule ^category/general/page/[0-9]+/?$ /category/general/ [R=301,L]
RewriteCond %{REQUEST_URI} !^/author/joseph-dittman/
RewriteRule ^author/.*$ /author/joseph-dittman/ [R=301,L]
RewriteRule ^(wp-admin|wp-includes|wp-json)(/.*)?$ / [R=301,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php)$ / [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^about/?$ /about-us/ [R=301,L]

# Never serve internals
RewriteRule ^(inc|leads)(/|$) - [F,L]
RewriteRule (^|/)\.(git|env) - [F,L]
RewriteRule \.(md|sh|py|jsonl)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType application/manifest+json "access plus 1 week"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
