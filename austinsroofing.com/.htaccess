# austinsroofing.com — custom PHP site (Hostinger Cloud, LiteSpeed/Apache)
DirectoryIndex index.php index.html
DirectorySlash On
Options -Indexes -MultiViews
ErrorDocument 404 /404.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Canonical host and scheme: https://austinsroofing.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://austinsroofing.com%{REQUEST_URI} [R=301,L,NE]

# Private folders
RewriteRule ^(includes|\.dev)(/|$) - [F,L]

# /index.php and /folder/index.php -> clean URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# XML sitemaps (same URLs Yoast used, so Search Console keeps working)
RewriteRule ^(sitemap_index|sitemap|wp-sitemap)\.xml$ /sitemap-xml.php?type=index [L,QSA]
RewriteRule ^(page|post|category|service|area|tool)-sitemap\.xml$ /sitemap-xml.php?type=$1 [L,QSA]

# Old WordPress post / page IDs (?p=, ?page_id=) -> permanent URLs
RewriteCond %{QUERY_STRING} (^|&)p=103(&|$)
RewriteRule ^$ /blog/what-is-a-square-in-roofing/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=127(&|$)
RewriteRule ^$ /blog/how-much-does-it-cost-to-replace-a-roof/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=130(&|$)
RewriteRule ^$ /blog/cost-of-asphalt-shingles-per-square/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=139(&|$)
RewriteRule ^$ /blog/residential-metal-roofing-lifespan/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=144(&|$)
RewriteRule ^$ /blog/architectural-shingle-vs-asphalt-shingles/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=149(&|$)
RewriteRule ^$ /blog/roof-replacement-permit-requirements/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=155(&|$)
RewriteRule ^$ /blog/attic-ventilation-upgrade-benefits/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=159(&|$)
RewriteRule ^$ /blog/ice-and-water-shield-installation-cost/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=163(&|$)
RewriteRule ^$ /blog/roofing-underlayment-material-types/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=167(&|$)
RewriteRule ^$ /blog/insurance-coverage-for-storm-damaged-roofs/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=171(&|$)
RewriteRule ^$ /blog/residential-roofing-warranty-coverage-guide-for-homeowners/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=23(&|$)
RewriteRule ^$ /about-us/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=25(&|$)
RewriteRule ^$ /contact-us/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=69(&|$)
RewriteRule ^$ /services/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=80(&|$)
RewriteRule ^$ /faqs/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=123(&|$)
RewriteRule ^$ /sitemap/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=3(&|$)
RewriteRule ^$ /privacy-policy/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=75(&|$)
RewriteRule ^$ /terms-of-service/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=18(&|$)
RewriteRule ^$ /? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)cat=1(&|$)
RewriteRule ^$ /category/general/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)s=
RewriteRule ^$ /blog/? [R=301,L]

# WordPress archives and feeds that no longer exist -> nearest live page
RewriteRule ^(feed|comments/feed|blog/feed)/?$ /blog/ [R=301,L]
RewriteRule ^blog/([^/]+)/feed/?$ /blog/$1/ [R=301,L]
RewriteRule ^blog/[0-9]{4}(/[0-9]{2}(/[0-9]{2})?)?/?$ /blog/ [R=301,L]
RewriteRule ^blog/page/[0-9]+/?$ /blog/ [R=301,L]
RewriteRule ^category/general/(feed|page/[0-9]+)/?$ /category/general/ [R=301,L]
RewriteRule ^author(/.*)?$ /about-us/ [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^contact/?$ /contact-us/ [R=301,L]
RewriteRule ^about/?$ /about-us/ [R=301,L]
RewriteRule ^faq/?$ /faqs/ [R=301,L]
RewriteRule ^terms(-of-use|-and-conditions)?/?$ /terms-of-service/ [R=301,L]
RewriteRule ^(wp-admin|wp-includes|wp-json|wp-login\.php|xmlrpc\.php|wp-signup\.php|wp-cron\.php)(/.*)?$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<FilesMatch "(^\.|\.(md|py|sh|log)$)">
Require all denied
</FilesMatch>
