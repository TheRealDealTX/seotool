# renternews.net - static site (generated by build.py from templates/htaccess)
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host and scheme
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://renternews.net/$1 [R=301,L]

# Old WordPress search (/?s=term) -> /search/?q=term
RewriteCond %{QUERY_STRING} (?:^|&)s=([^&]*)
RewriteRule ^$ /search/?q=%1 [R=301,L,NE]

# Old WordPress shortlinks (/?p=ID, /?page_id=ID) -> article URLs
RewriteCond %{QUERY_STRING} ^p=193$
RewriteRule ^$ /news/san-jose-apartment-fire-displaces-13-residents-and-their-pets/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=96$
RewriteRule ^$ /news/memphis-apartment-fire-leaves-1-dead-4-injured/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=93$
RewriteRule ^$ /news/attleboro-apartment-fire-leaves-24-displaced/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=89$
RewriteRule ^$ /news/chicago-west-side-apartment-fire-full-story/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=86$
RewriteRule ^$ /news/millcreek-apartment-fire-leaves-79-without-homes/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=83$
RewriteRule ^$ /news/sacramento-apartment-fire-leaves-one-dead/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=80$
RewriteRule ^$ /news/canton-apartment-fire-under-investigation/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=77$
RewriteRule ^$ /news/new-london-apartment-fire-4-hospitalized-50-displaced/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=74$
RewriteRule ^$ /news/tucson-apartment-fire-displaces-seven/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=71$
RewriteRule ^$ /news/oakland-apartment-fire-erupts-in-unoccupied-building/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=68$
RewriteRule ^$ /news/concord-apartment-fire-leaves-one-dead-many-displaced/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=65$
RewriteRule ^$ /news/milwaukee-apartment-fire-leaves-child-dead-mother-critical/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=62$
RewriteRule ^$ /news/charlotte-apartment-fire-one-dead-and-dozens-displaced/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=59$
RewriteRule ^$ /news/inside-the-portland-apartment-fire-disaster/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=56$
RewriteRule ^$ /news/apartment-fire-in-orosi-california-35-displaced/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=53$
RewriteRule ^$ /news/14-residents-displaced-after-santa-ana-apartment-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=50$
RewriteRule ^$ /news/neenah-wisconsin-apartment-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=47$
RewriteRule ^$ /news/southwest-houston-apartment-fire-leaves-5-injured/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=44$
RewriteRule ^$ /news/phoenix-az-apartment-fire-leaves-one-man-critically-injured/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=41$
RewriteRule ^$ /news/oswego-apartment-fire-leaves-nine-without-homes/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=38$
RewriteRule ^$ /news/melvindale-apartment-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=35$
RewriteRule ^$ /news/muirwood-lancaster-apartment-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=32$
RewriteRule ^$ /news/aurora-apartment-fire-illinois/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=29$
RewriteRule ^$ /news/villas-on-springvale-apartment-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=26$
RewriteRule ^$ /news/baldwin-ny-apartment-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=23$
RewriteRule ^$ /news/bronx-apartment-fire-nyc/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=20$
RewriteRule ^$ /news/austin-apartment-fire-in-chicago/? [R=301,L]
RewriteCond %{QUERY_STRING} ^p=10$
RewriteRule ^$ /news/the-cooper-apartments-fire/? [R=301,L]
RewriteCond %{QUERY_STRING} ^page_id=188$
RewriteRule ^$ /terms-of-service/? [R=301,L]
RewriteCond %{QUERY_STRING} ^page_id=133$
RewriteRule ^$ /contact/? [R=301,L]
RewriteCond %{QUERY_STRING} ^page_id=131$
RewriteRule ^$ /frequently-asked-questions/? [R=301,L]
RewriteCond %{QUERY_STRING} ^page_id=129$
RewriteRule ^$ /about/? [R=301,L]
RewriteCond %{QUERY_STRING} ^page_id=3$
RewriteRule ^$ /privacy-policy/? [R=301,L]

# RSS feeds (WordPress served them at /feed/)
RewriteRule ^(?:feed|comments/feed|news/feed|news/category/[^/]+/feed)/?$ /feed.xml [L,T=application/rss+xml]

# Old WordPress author archive and home pagination
RewriteRule ^news/author/inforenternews-net/?$ /news/author/renter-news-staff/ [R=301,L]
RewriteRule ^page/([0-9]+)/?$ /news/page/$1/ [R=301,L]

# WordPress-only endpoints are gone
RewriteRule ^(?:wp-admin|wp-includes|wp-json)(?:/.*)?$ / [R=301,L]
RewriteRule ^(?:wp-login\.php|xmlrpc\.php|wp-cron\.php)$ - [G,L]

# Add a trailing slash to directory URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/rss+xml application/xml text/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
