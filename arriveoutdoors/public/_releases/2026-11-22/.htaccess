RewriteRule ^how-to-keep-a-tent-cool-in-the-summer/?$ /cool-a-tent-without-electricity/ [R=301,L,NE,QSD]
RewriteRule ^ways-to-stay-cool-while-camping/?$ /cool-a-tent-without-electricity/ [R=301,L,NE,QSD]
RewriteRule ^how-to-stay-clean-while-camping/?$ /backpacking-hygiene/ [R=301,L,NE,QSD]
RewriteRule ^renting-camp-gear-for-beginners/?$ /rent-camping-gear/ [R=301,L,NE,QSD]
RewriteRule ^where-to-rent-camping-gear-near-me/?$ /rent-camping-gear/ [R=301,L,NE,QSD]
RewriteRule ^water-filter-backpacking/?$ /sawyer-squeeze-gravity-setup/ [R=301,L,NE,QSD]
RewriteRule ^hiking-training-plan/?$ /tools/hiking-time-calculator/ [R=301,L,NE,QSD]
RewriteRule ^resupply-pct-a-complete-guide-for-thru-hikers/?$ /tools/camp-meal-planner/ [R=301,L,NE,QSD]
RewriteRule ^edge-of-the-world-arizona/?$ /destinations/grand-canyon/ [R=301,L,NE,QSD]

# Catch-alls for old WordPress / Shopify URL patterns
RewriteRule ^products/.+$ /gear/ [R=301,L,QSD]
RewriteRule ^group/.+$ /gear/ [R=301,L,QSD]
RewriteRule ^collections(/.*)?$ /gear/ [R=301,L,QSD]
RewriteRule ^pages/.+$ /destinations/ [R=301,L,QSD]
RewriteRule ^blogs/(?!the-outdoor-traveler/camping-101-a-guide-for-the-first-time-camper).+$ /guides/ [R=301,L,QSD]
RewriteRule ^(category|tag)/.+$ /guides/ [R=301,L,QSD]
RewriteRule ^author/.+$ /about/ [R=301,L,QSD]
RewriteRule ^20[0-9]{2}/.*$ /guides/ [R=301,L,QSD]
RewriteRule ^(comments/)?feed/?$ /guides/ [R=301,L,QSD]
RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L,QSD]
RewriteRule ^(.+)/amp/?$ /$1/ [R=301,L,QSD]

# Anything else that isn't a real file or folder gets the 404 page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . - [R=404,L]
