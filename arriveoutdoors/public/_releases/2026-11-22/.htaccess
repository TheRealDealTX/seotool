# Arrive Outdoors static site (generated by build.py — edit siteconfig.py, not this file)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresByType text/css A31536000
  ExpiresByType application/javascript A31536000
  ExpiresByType text/javascript A31536000
  ExpiresByType image/webp A31536000
  ExpiresByType image/png A31536000
  ExpiresByType image/svg+xml A31536000
  ExpiresByType text/html A600
</IfModule>

RewriteEngine On
RewriteBase /
# Canonical host: https://arriveoutdoors.com
RewriteCond %{HTTP_HOST} ^www\.arriveoutdoors\.com$ [NC]
RewriteRule ^(.*)$ https://arriveoutdoors.com/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://arriveoutdoors.com/$1 [R=301,L]

# Scheduled-release packs are applied by cron, never served directly
RewriteRule ^_releases(/|$) - [F,L]

# Scheduled articles not yet published (removed from this list on their release date)
RewriteRule ^new-hampshire-hiking/?$ - [R=404,L]

# Removed content (410 Gone)
RewriteRule ^book-your-luxury-villa-getaway/?$ - [G,L]
RewriteRule ^adventure-travel-planning-made-easy/?$ - [G,L]
RewriteRule ^things-to-do-in-fire-island/?$ - [G,L]
RewriteRule ^hajar-mountains/?$ - [G,L]
RewriteRule ^mount-hua-shan-where-peaks-touch-sky/?$ - [G,L]
RewriteRule ^nangma-valley/?$ - [G,L]
RewriteRule ^hiking-in-patagonia/?$ - [G,L]
RewriteRule ^things-to-do-in-kenai-alaska/?$ - [G,L]
RewriteRule ^hello-world/?$ - [G,L]

# Legacy URLs → new pages (301)
RewriteRule ^class-3-scrambling/?$ /class-3-scramble/ [R=301,L,NE,QSD]
RewriteRule ^hiking-backpack-black-friday/?$ /best-hiking-black-friday-deals/ [R=301,L,NE,QSD]
RewriteRule ^how-to-look-good-in-hiking-pictures/?$ /how-to-pose-for-hiking-pictures/ [R=301,L,NE,QSD]
RewriteRule ^camera-strap-for-hiking/?$ /best-camera-for-backpacking/ [R=301,L,NE,QSD]
RewriteRule ^tips-for-renting-camping-equipment-for-a-trip/?$ /rent-camping-gear/ [R=301,L,NE,QSD]
RewriteRule ^arrive-outdoors-camping-gear-rental-review/?$ /about/ [R=301,L,NE,QSD]
RewriteRule ^blogs/?$ /guides/ [R=301,L,NE,QSD]
RewriteRule ^blogs/the-outdoor-traveler/?$ /guides/ [R=301,L,NE,QSD]
RewriteRule ^faq/?$ /about/ [R=301,L,NE,QSD]
RewriteRule ^category/blog/?$ /guides/ [R=301,L,NE,QSD]
RewriteRule ^category/uncategorized/?$ /guides/ [R=301,L,NE,QSD]
RewriteRule ^products/?$ /gear/ [R=301,L,NE,QSD]
RewriteRule ^group/boots/?$ /gear/#footwear [R=301,L,NE,QSD]
