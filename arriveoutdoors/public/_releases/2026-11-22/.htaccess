RewriteRule ^group/camphike/chairs/?$ /gear/#camp [R=301,L,NE,QSD]
RewriteRule ^group/camphike/packs/?$ /gear/#packs [R=301,L,NE,QSD]
RewriteRule ^group/camphike/tents/?$ /gear/#camp [R=301,L,NE,QSD]
