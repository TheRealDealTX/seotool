RewriteRule ^products/oboz-womens-sawtooth-ii-low-waterproof-hiking-boot/?$ /gear/#footwear [R=301,L,NE,QSD]
RewriteRule ^products/oboz-mens-bridger-mid-waterproof-hiking-boot/?$ /gear/#footwear [R=301,L,NE,QSD]
RewriteRule ^products/oboz-womans-bridger-mid-waterproof-hiking-boot/?$ /gear/#footwear [R=301,L,NE,QSD]
RewriteRule ^products/complete-backpacking-set-for-two/?$ /tools/packing-list/ [R=301,L,NE,QSD]
RewriteRule ^products/marmot-limelight-3-person-tent/?$ /gear/#camp [R=301,L,NE,QSD]
