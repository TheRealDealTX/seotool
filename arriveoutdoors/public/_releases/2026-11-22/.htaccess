RewriteRule ^products/helinox-chair-one/?$ /gear/#camp [R=301,L,NE,QSD]
RewriteRule ^pages/?$ /destinations/ [R=301,L,NE,QSD]
RewriteRule ^pages/parks/?$ /destinations/ [R=301,L,NE,QSD]
RewriteRule ^pages/about/?$ /about/ [R=301,L,NE,QSD]
RewriteRule ^pages/how-it-works/?$ /rent-camping-gear/ [R=301,L,NE,QSD]
RewriteRule ^pages/yosemite/?$ /destinations/yosemite/ [R=301,L,NE,QSD]
RewriteRule ^pages/sunday-river/?$ /rent-camping-gear/ [R=301,L,NE,QSD]
RewriteRule ^collections/?$ /gear/ [R=301,L,NE,QSD]
RewriteRule ^collections/all/?$ /gear/ [R=301,L,NE,QSD]
RewriteRule ^group/camphike/category/27/?$ /gear/ [R=301,L,NE,QSD]
RewriteRule ^appalachian-trail-shelters-a-hikers-lifeline-in-the-wilderness/?$ /destinations/great-smoky-mountains/ [R=301,L,NE,QSD]
RewriteRule ^backpacking-lunch-ideas/?$ /tools/camp-meal-planner/ [R=301,L,NE,QSD]
RewriteRule ^vegan-backpacking-food/?$ /tools/camp-meal-planner/ [R=301,L,NE,QSD]
RewriteRule ^backpacking-luxury-items/?$ /tools/packing-list/ [R=301,L,NE,QSD]
RewriteRule ^backpacking-necessities/?$ /tools/packing-list/ [R=301,L,NE,QSD]
RewriteRule ^solo-backpacking/?$ /what-to-do-if-you-get-lost-in-the-woods/ [R=301,L,NE,QSD]
RewriteRule ^best-base-layer-for-hiking/?$ /gear/#clothing [R=301,L,NE,QSD]
RewriteRule ^hiking-clothes-for-men/?$ /gear/#clothing [R=301,L,NE,QSD]
RewriteRule ^womens-hiking-shorts/?$ /gear/#clothing [R=301,L,NE,QSD]
RewriteRule ^mens-lightweight-hoodie/?$ /best-sun-hoodies-for-hiking/ [R=301,L,NE,QSD]
RewriteRule ^womens-hiking-shirts-for-hot-weather/?$ /best-sun-hoodies-for-hiking/ [R=301,L,NE,QSD]
