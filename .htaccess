# Last resort: unknown pages in each section go to that section's hub
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^SBA-Loan/.+$ /SBA-Loan/ [QSD,R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(SBA-Loans|listings)/.+$ /SBA-Loans/ [QSD,R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^blog/.+$ /blog/Small\%20Business\%20Administration/ [QSD,R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pages/.+$ /pages/top-sba-lenders-in-2025/ [QSD,R=301,L]
# section roots in the wrong case
RewriteCond %{REQUEST_URI} !^/SBA-Loans/$
RewriteRule ^sba-loans/?$ /SBA-Loans/ [NC,QSD,R=301,L]
RewriteCond %{REQUEST_URI} !^/SBA-Loan/$
RewriteRule ^sba-loan/?$ /SBA-Loan/ [NC,QSD,R=301,L]
RewriteRule ^(blog|pages|listings)/?$ / [NC,QSD,R=301,L]

# Junk / pagination query strings on live pages -> same page, no query
RewriteCond %{QUERY_STRING} (^|&)(listingPage|categories_page|directory(%5B|\[)[^=&]*)= [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*[^/])$ /$1/ [QSD,R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(listingPage|categories_page|directory(%5B|\[)[^=&]*)= [NC]
RewriteRule ^(.*)$ /$1 [QSD,R=301,L]

# add trailing slash to folder URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType text/html "access plus 1 hour"
</IfModule>
