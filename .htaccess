RewriteRule ^SBA-Loans?/hotels[^a-z0-9]*except[^a-z0-9]*casino[^a-z0-9]*hotels[^a-z0-9]*and[^a-z0-9]*motels/?$ /SBA-Loan/Hotels\%20(except\%20Casino\%20Hotels)\%20and\%20Motels/ [NC,QSD,R=301,L]
