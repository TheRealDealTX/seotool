# sbarates.com static site
# Updated 2026-11-05: 301 redirects for old/broken URLs (backup: .htaccess.bak-2026-11-05)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# force https and bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://sbarates.com/$1 [R=301,L,NE]

# ---------------------------------------------------------------
# Old-URL redirects. Every rule drops the query string (QSD) and
# goes straight to a live page, so each old URL is one hop.
# Rules are skipped when the requested folder really exists (!-d).
# ---------------------------------------------------------------

# Old directory landing page
RewriteRule ^lander/?$ /SBA-Loans/ [QSD,R=301,L]

# Industry pages: any case, hyphens/underscores/double spaces/missing punctuation

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^SBA-Loans?/administrative[^a-z0-9]*management[^a-z0-9]*and[^a-z0-9]*general[^a-z0-9]*management[^a-z0-9]*consulting[^a-z0-9]*services/?$ /SBA-Loan/Administrative\%20Management\%20and\%20General\%20Management\%20Consulting\%20Services/ [NC,QSD,R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^SBA-Loans?/all[^a-z0-9]*other[^a-z0-9]*miscellaneous[^a-z0-9]*food[^a-z0-9]*manufacturing/?$ /SBA-Loan/All\%20Other\%20Miscellaneous\%20Food\%20Manufacturing/ [NC,QSD,R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^SBA-Loans?/all[^a-z0-9]*other[^a-z0-9]*support[^a-z0-9]*services/?$ /SBA-Loan/All\%20Other\%20Support\%20Services/ [NC,QSD,R=301,L]
