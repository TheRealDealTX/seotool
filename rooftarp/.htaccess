# Generated by build.py - do not edit by hand.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host and scheme
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://rooftarp.com/$1 [R=301,L]

# 141 removed near-duplicate city pages -> 410 Gone.
# These earned zero clicks in the 16 months to 2026-09-19 and were
# 96-98% identical to one another. 410 tells Google they are
# intentionally gone, which de-indexes them faster than a 404.
RewriteRule ^service-areas/(roof-tarp-abilene|roof-tarp-allen|roof-tarp-alton|roof-tarp-alvin|roof-tarp-amarillo|roof-tarp-anna|roof-tarp-atascocita|roof-tarp-balch-springs|roof-tarp-bastrop|roof-tarp-baytown|roof-tarp-bedford|roof-tarp-belton|roof-tarp-benbrook|roof-tarp-big-spring|roof-tarp-boerne|roof-tarp-brownsville|roof-tarp-brushy-creek|roof-tarp-bryan|roof-tarp-burleson|roof-tarp-canyon-lake)/?$ - [G,L]
RewriteRule ^service-areas/(roof-tarp-carrollton|roof-tarp-cedar-hill|roof-tarp-cedar-park|roof-tarp-celina|roof-tarp-channelview|roof-tarp-cibolo|roof-tarp-cleburne|roof-tarp-cloverleaf|roof-tarp-college-station|roof-tarp-colleyville|roof-tarp-conroe|roof-tarp-converse|roof-tarp-coppell|roof-tarp-copperas-cove|roof-tarp-corinth|roof-tarp-corsicana|roof-tarp-deer-park|roof-tarp-del-rio|roof-tarp-denison|roof-tarp-desoto)/?$ - [G,L]
