RewriteRule ^(wp-admin|wp-includes|wp-login\.php|xmlrpc\.php) - [G,L]
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap)\.xml$ /sitemap.xml [R=301,L]
