RewriteRule ^service-areas/(roof-tarp-haltom-city|roof-tarp-harker-heights|roof-tarp-harlingen|roof-tarp-horizon-city|roof-tarp-hurst|roof-tarp-irving|roof-tarp-katy|roof-tarp-keller|roof-tarp-kerrville|roof-tarp-killeen|roof-tarp-kingsville|roof-tarp-kyle|roof-tarp-la-porte|roof-tarp-lake-jackson|roof-tarp-lancaster|roof-tarp-laredo|roof-tarp-league-city|roof-tarp-leander|roof-tarp-lewisville|roof-tarp-little-elm)/?$ - [G,L]
RewriteRule ^service-areas/(roof-tarp-longview|roof-tarp-lufkin|roof-tarp-mansfield|roof-tarp-marshall|roof-tarp-mcallen|roof-tarp-melissa|roof-tarp-mesquite|roof-tarp-midlothian|roof-tarp-mission|roof-tarp-mission-bend|roof-tarp-missouri-city|roof-tarp-nacogdoches|roof-tarp-new-braunfels|roof-tarp-north-richland-hills|roof-tarp-odessa|roof-tarp-paris|roof-tarp-pasadena|roof-tarp-pearland|roof-tarp-pecan-grove|roof-tarp-pflugerville)/?$ - [G,L]
