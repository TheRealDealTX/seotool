# thepropertylaw.com - Hostinger Cloud (LiteSpeed)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /index.php

RewriteEngine On
# Canonical host: https://thepropertylaw.com (www and http redirect to it)
RewriteCond %{HTTP_HOST} ^www\.thepropertylaw\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?thepropertylaw\.com$ [NC]
RewriteRule ^ https://thepropertylaw.com%{REQUEST_URI} [R=301,L]

# Lead storage is never served
RewriteRule ^data/ - [R=404,L]

# Home and anything that is not a real file or directory -> front controller (real 404s)
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
