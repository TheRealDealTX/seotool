# deniedfloodclaim.com on Hostinger Cloud (LiteSpeed)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /index.php

RewriteEngine On
# www -> apex and http -> https, one hop
RewriteCond %{HTTP_HOST} ^www\.deniedfloodclaim\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?deniedfloodclaim\.com$ [NC]
RewriteRule ^ https://deniedfloodclaim.com%{REQUEST_URI} [R=301,L]

# Lead storage is never served
RewriteRule ^data(/|$) - [R=404,L]

# Home page and anything that is not a real file or directory -> front controller (real 404)
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
