# pensacolahurricane.com on Hostinger Cloud (LiteSpeed).
DirectoryIndex index.html index.php
Options -Indexes

RewriteEngine On
# www -> apex, http -> https
RewriteCond %{HTTP_HOST} ^www\.pensacolahurricane\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?pensacolahurricane\.com$ [NC]
RewriteRule ^ https://pensacolahurricane.com%{REQUEST_URI} [R=301,L]

# Home page and anything that is not a real file or directory -> front controller
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<FilesMatch "\.(css|js|png|jpg|svg|ico|woff2)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
