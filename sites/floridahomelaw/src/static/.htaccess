# floridahomelaw.com - Hostinger Cloud (LiteSpeed)
DirectoryIndex index.html index.php
Options -Indexes

RewriteEngine On
# www -> apex and http -> https, one hop
RewriteCond %{HTTP_HOST} ^www\.floridahomelaw\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?floridahomelaw\.com$ [NC]
RewriteRule ^ https://floridahomelaw.com%{REQUEST_URI} [R=301,L]

# Keep stored leads private
RewriteRule ^data/ - [R=404,L]

# Home page, and every URL that is not a real file or folder, go to the front controller
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
