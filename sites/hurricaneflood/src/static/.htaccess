# hurricaneflood.com (Hostinger Cloud, LiteSpeed)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# www -> apex and http -> https, one hop
RewriteCond %{HTTP_HOST} ^www\.hurricaneflood\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?hurricaneflood\.com$ [NC]
RewriteRule ^ https://hurricaneflood.com%{REQUEST_URI} [R=301,L]

# Keep the raw home body file out of search results
RewriteRule ^home\.html$ / [R=301,L]

# Home and anything that is not a real file or directory -> front controller (real 404s)
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
